# ReSpeaker XVF3800 USB 4-Mic Array udev rules
# Copy to /etc/udev/rules.d/ and reload with:
#   sudo udevadm control --reload-rules
# Then unplug and replug the device.

# Seeed Studio Vendor ID
SUBSYSTEM=="usb", ATTRS{idVendor}=="2886", TAG+="uaccess", MODE="0666"

# XMOS Vendor ID
SUBSYSTEM=="usb", ATTRS{idVendor}=="20b1", TAG+="uaccess", MODE="0666"
