# Loupedeck and Razer Stream Controller udev rules
# Copy to /etc/udev/rules.d/ and reload with:
#   sudo udevadm control --reload-rules
# Then unplug and replug the device.

# Loupedeck Live
SUBSYSTEM=="tty", ATTRS{idVendor}=="2ec2", ATTRS{idProduct}=="0001", TAG+="uaccess", MODE="0666"
# Loupedeck Live S
SUBSYSTEM=="tty", ATTRS{idVendor}=="2ec2", ATTRS{idProduct}=="0006", TAG+="uaccess", MODE="0666"
# Loupedeck CT
SUBSYSTEM=="tty", ATTRS{idVendor}=="2ec2", ATTRS{idProduct}=="0004", TAG+="uaccess", MODE="0666"
# Razer Stream Controller
SUBSYSTEM=="tty", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0d06", TAG+="uaccess", MODE="0666"
# Razer Stream Controller X
SUBSYSTEM=="tty", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0d09", TAG+="uaccess", MODE="0666"
